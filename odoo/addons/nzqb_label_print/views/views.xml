<odoo>
    <record id="view_printer_list" model="ir.ui.view"><field name="name">nzqb.label.printer.list</field><field name="model">nzqb.label.printer</field><field name="arch" type="xml"><list><field name="name"/><field name="host"/><field name="dpi"/><field name="last_seen"/><field name="agent_name"/><field name="active"/></list></field></record>
    <record id="view_printer_form" model="ir.ui.view"><field name="name">nzqb.label.printer.form</field><field name="model">nzqb.label.printer</field><field name="arch" type="xml"><form string="작업장 프린터"><sheet><group><group><field name="name"/><field name="active"/><field name="company_id" groups="base.group_multi_company"/><field name="host"/><field name="port"/><field name="dpi"/><field name="mode"/></group><group><field name="speed"/><field name="darkness"/><field name="timeout"/><field name="max_queue_minutes"/><field name="agent_user_id" groups="nzqb_label_print.group_label_manager"/><field name="last_seen"/><field name="agent_name"/></group></group><div class="alert alert-info" role="status">프린터는 인터넷에 공개하지 않습니다. 작업장 PC의 연결 프로그램이 Odoo 요청을 받아 출력합니다. 전송 완료는 실제 출력 매수 확인을 의미하지 않습니다.</div><field name="note"/></sheet></form></field></record>
    <record id="view_template_list" model="ir.ui.view"><field name="name">nzqb.label.template.list</field><field name="model">nzqb.label.template</field><field name="arch" type="xml"><list><field name="name"/><field name="width_mm"/><field name="height_mm"/><field name="feed_edge"/><field name="upside_down"/><field name="plain"/></list></field></record>
    <record id="view_template_form" model="ir.ui.view"><field name="name">nzqb.label.template.form</field><field name="model">nzqb.label.template</field><field name="arch" type="xml">
        <form string="라벨 설정"><header><button name="action_new_job" type="object" string="이 라벨 인쇄" class="btn-primary"/><button name="action_copy_settings" type="object" string="선택한 라벨 설정 가져오기" groups="nzqb_label_print.group_label_manager"/></header><sheet>
            <field name="photo" widget="image" class="oe_avatar"/>
            <group><group><field name="name"/><field name="active"/><field name="plain"/><field name="product_id"/><field name="copy_from_id" domain="[('id','!=',id)]" groups="nzqb_label_print.group_label_manager"/></group><group><field name="company_id" groups="base.group_multi_company"/><field name="width_mm"/><field name="height_mm"/><field name="gap_mm"/></group></group>
            <div class="alert alert-info" role="status">라벨의 글자가 똑바로 보이게 놓고 가로·세로를 입력하세요. 먼저 나오는 변도 이 상태를 기준으로 고릅니다. 사진은 구분용이며 출력되지 않습니다.</div>
            <group string="출력 방향과 위치"><field name="feed_edge"/><field name="upside_down"/><field name="offset_x_mm"/><field name="offset_y_mm"/></group>
            <div class="text-muted">위치 보정은 회전 후 출력 미리보기 기준입니다. +좌우는 오른쪽, +상하는 아래쪽이며 미리보기의 위쪽 변이 먼저 나옵니다.</div>
            <notebook><page string="인쇄 영역"><field name="area_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="x_mm"/><field name="y_mm"/><field name="width_mm"/><field name="height_mm"/><field name="text"/><field name="font_pt"/><field name="bold"/><field name="centered"/></list></field>
                <div class="alert alert-info" role="status">내용에 {BATCH}, {BB}, {MFG}, {PRODUCT}, {WEIGHT}, {QTY}, {STORAGE}, {RMP}, {ORIGIN}, {COMPANY}를 사용하세요. 값이 빈 항목이 있는 줄은 빠집니다. Batch: 등 머리말은 인쇄 요청에서 선택하므로 내용에는 항목 코드만 적으세요. 글자 크기 0은 자동 맞춤입니다.</div>
            </page><page string="무지 라벨 기본 문구"><group><field name="default_storage"/><field name="default_rmp"/><field name="default_origin"/><field name="default_company"/></group></page></notebook>
        </sheet></form>
    </field></record>
    <record id="view_batch_list" model="ir.ui.view"><field name="name">nzqb.label.batch.list</field><field name="model">nzqb.label.batch</field><field name="arch" type="xml"><list delete="0"><field name="name"/><field name="product_id"/><field name="lot_id"/><field name="mfg_date"/><field name="bb_mgo"/><field name="bb_umf"/></list></field></record>
    <record id="view_batch_form" model="ir.ui.view"><field name="name">nzqb.label.batch.form</field><field name="model">nzqb.label.batch</field><field name="arch" type="xml"><form delete="0"><sheet><group><field name="lot_id"/><field name="name"/><field name="product_id"/><field name="mfg_date"/><field name="bb_mgo"/><field name="bb_umf"/><field name="company_id" groups="base.group_multi_company"/></group><field name="note"/><div class="alert alert-info" role="status">저장한 배치는 삭제할 수 없습니다. 날짜 수정 이력은 아래에 기록됩니다.</div></sheet><chatter/></form></field></record>
    <record id="view_phrase_list" model="ir.ui.view"><field name="name">nzqb.label.phrase.list</field><field name="model">nzqb.label.phrase</field><field name="arch" type="xml"><list editable="bottom" delete="0"><field name="category"/><field name="name"/><field name="active"/></list></field></record>
    <record id="view_job_list" model="ir.ui.view"><field name="name">nzqb.label.job.list</field><field name="model">nzqb.label.job</field><field name="arch" type="xml"><list delete="0" decoration-warning="state in ('held','uncertain')" decoration-success="state == 'sent'" decoration-danger="state == 'failed'"><field name="name"/><field name="state"/><field name="template_id"/><field name="batch_number"/><field name="copies" sum="요청 매수"/><field name="printer_id"/><field name="requested_by"/><field name="requested_at"/><field name="processed_at"/></list></field></record>
    <record id="view_job_search" model="ir.ui.view"><field name="name">nzqb.label.job.search</field><field name="model">nzqb.label.job</field><field name="arch" type="xml"><search><field name="name"/><field name="template_id"/><field name="batch_number"/><field name="printer_id"/><filter name="waiting" string="인쇄 대기" domain="[('state','=','queued')]"/><filter name="needs_attention" string="확인 필요" domain="[('state','in',['held','uncertain','failed'])]"/><filter name="sent" string="전송 완료" domain="[('state','=','sent')]"/><group><filter name="group_template" string="라벨별" context="{'group_by':'template_id'}"/><filter name="group_batch" string="배치별" context="{'group_by':'batch_number'}"/><filter name="group_state" string="상태별" context="{'group_by':'state'}"/></group></search></field></record>
    <record id="view_job_form" model="ir.ui.view"><field name="name">nzqb.label.job.form</field><field name="model">nzqb.label.job</field><field name="arch" type="xml">
        <form delete="0" duplicate="0" string="라벨 인쇄"><header>
            <button name="action_preview" type="object" string="미리보기 갱신" invisible="state != 'draft'"/>
            <button name="action_queue" type="object" string="인쇄 요청" class="btn-primary" invisible="state != 'draft'" confirm="선택한 프린터에 이 매수로 인쇄를 요청합니다."/>
            <button name="action_cancel" type="object" string="요청 취소" invisible="state not in ('draft','queued','held')"/>
            <button name="action_release" type="object" string="지금 출력하도록 승인" invisible="state != 'held'" confirm="오래 대기한 요청을 지금 출력하도록 승인합니다."/>
            <button name="action_reprint" type="object" string="새 재인쇄 요청" invisible="state in ('draft','queued','processing')"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,queued,processing,sent"/>
        </header><sheet><div class="alert alert-info" role="status">프린터로 전송 완료된 매수와 실제 출력 매수는 다를 수 있습니다. 결과가 불분명한 요청은 자동 재인쇄하지 않습니다.</div>
            <h1><field name="name"/></h1>
            <group><group><field name="template_id" readonly="state != 'draft'"/><field name="printer_id" readonly="state != 'draft'"/><field name="product_id" readonly="state != 'draft'"/><field name="copies" readonly="state != 'draft'"/><field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/></group>
            <group><field name="batch_id" readonly="state != 'draft'"/><field name="batch_number" readonly="state != 'draft'"/><field name="mfg_date" readonly="state != 'draft'"/><field name="bb_kind" readonly="state != 'draft'"/><field name="bb_date" readonly="state != 'draft'"/><field name="date_format" readonly="state != 'draft'"/></group></group>
            <group string="머리말 선택"><field name="batch_prefix" readonly="state != 'draft'"/><field name="bb_prefix" readonly="state != 'draft'"/><field name="mfg_prefix" readonly="state != 'draft'"/></group>
            <notebook><page string="미리보기"><field name="preview" widget="image" options="{'size':[700,700]}"/><div class="text-muted">위쪽이 프린터에서 먼저 나오는 변입니다. 새 요청은 미리보기 갱신을 눌러 확인하세요. 접수 후에는 요청 당시의 이미지가 보관됩니다.</div></page>
            <page string="무지 라벨 문구"><div class="text-muted">저장된 문구를 선택하거나 직접 입력하세요. 인쇄하지 않을 항목은 입력값을 비우세요.</div><group>
                <group><field name="product_phrase_id" readonly="state != 'draft'"/><field name="product_text" readonly="state != 'draft'"/><field name="weight_phrase_id" readonly="state != 'draft'"/><field name="weight_text" readonly="state != 'draft'"/><field name="qty_phrase_id" readonly="state != 'draft'"/><field name="qty_text" readonly="state != 'draft'"/></group>
                <group><field name="storage_phrase_id" readonly="state != 'draft'"/><field name="storage_text" readonly="state != 'draft'"/><field name="rmp_phrase_id" readonly="state != 'draft'"/><field name="rmp_text" readonly="state != 'draft'"/><field name="origin_phrase_id" readonly="state != 'draft'"/><field name="origin_text" readonly="state != 'draft'"/><field name="company_phrase_id" readonly="state != 'draft'"/><field name="company_text" readonly="state != 'draft'"/></group>
            </group></page>
            <page string="전송 기록"><group><field name="requested_by"/><field name="requested_at"/><field name="expires_at"/><field name="claimed_at"/><field name="processed_at"/><field name="agent_name"/><field name="payload_hash"/><field name="original_job_id"/><field name="reprint_reason" readonly="state != 'draft'"/></group><field name="result_message"/><field name="snapshot" groups="nzqb_label_print.group_label_manager"/></page></notebook>
        </sheet><chatter/></form>
    </field></record>
    <record id="action_jobs" model="ir.actions.act_window"><field name="name">인쇄 요청·이력</field><field name="res_model">nzqb.label.job</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_job_search"/></record>
    <record id="action_new_job" model="ir.actions.act_window"><field name="name">라벨 인쇄</field><field name="res_model">nzqb.label.job</field><field name="view_mode">form</field><field name="target">current</field></record>
    <record id="action_templates" model="ir.actions.act_window"><field name="name">등록 라벨</field><field name="res_model">nzqb.label.template</field><field name="view_mode">list,form</field></record>
    <record id="action_batches" model="ir.actions.act_window"><field name="name">저장한 배치</field><field name="res_model">nzqb.label.batch</field><field name="view_mode">list,form</field></record>
    <record id="action_phrases" model="ir.actions.act_window"><field name="name">미리 써 둔 문구</field><field name="res_model">nzqb.label.phrase</field><field name="view_mode">list,form</field></record>
    <record id="action_printers" model="ir.actions.act_window"><field name="name">작업장 프린터</field><field name="res_model">nzqb.label.printer</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_root" name="라벨 인쇄" sequence="25" groups="group_label_operator"/>
    <menuitem id="menu_print" name="새 인쇄 요청" parent="menu_root" action="action_new_job" sequence="5"/>
    <menuitem id="menu_jobs" name="인쇄 요청·이력" parent="menu_root" action="action_jobs" sequence="10"/>
    <menuitem id="menu_templates" name="등록 라벨" parent="menu_root" action="action_templates" sequence="20"/>
    <menuitem id="menu_batches" name="저장한 배치" parent="menu_root" action="action_batches" sequence="30"/>
    <menuitem id="menu_phrases" name="미리 써 둔 문구" parent="menu_root" action="action_phrases" sequence="40"/>
    <menuitem id="menu_printers" name="작업장 프린터" parent="menu_root" action="action_printers" sequence="50" groups="group_label_manager"/>
</odoo>
